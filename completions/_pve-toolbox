#compdef pve-toolbox
# Guest modules such as komodo-periphery use dynamic module/tag discovery.
#
# zsh completion for pve-toolbox.
#
# Candidates come from `pve-toolbox _complete`, so a module dropped into
# modules/ is completable immediately - no names are listed here. The
# launcher is invoked as $words[1], so completing ./pve-toolbox in a
# checkout asks that checkout rather than whatever is on PATH.

_pve-toolbox_candidates() { # _pve-toolbox_candidates <target> [args...]
    "${words[1]}" _complete "$@" 2>/dev/null
}

_pve-toolbox() {
    local cmd="" arg1="" i
    integer nargs=0
    local -a cands

    # The first non-flag word after the program name is the command; the rest
    # are its arguments. Flags are accepted anywhere, so they cannot simply be
    # counted by position.
    for (( i = 2; i < CURRENT; i++ )); do
        [[ $words[i] == -* ]] && continue
        if [[ -z $cmd ]]; then
            cmd=$words[i]
        else
            (( nargs++ ))
            (( nargs > 1 )) || arg1=$words[i]
        fi
    done

    # --color's value is not read from the command table: it is the same
    # three words for every command, checked before the generic flag branch
    # since --color=* also matches -*.
    if [[ $words[CURRENT] == --color=* ]]; then
        local -a colors
        colors=(--color=auto --color=always --color=never)
        compadd -a colors
        return
    fi
    if [[ $words[CURRENT] == -* ]]; then
        local -a flagspecs
        flagspecs=( ${(f)"$(_pve-toolbox_candidates flag-help $cmd)"} )
        _describe 'flag' flagspecs
        return
    fi

    case $cmd in
        "")        cands=( ${(f)"$(_pve-toolbox_candidates commands)"} ) ;;
        help)      # takes a single optional command name
                   (( nargs )) && return 1
                   cands=( ${(f)"$(_pve-toolbox_candidates commands)"} ) ;;
        list)      # takes a single optional tag
                   (( nargs )) && return 1
                   cands=( ${(f)"$(_pve-toolbox_candidates tags)"} ) ;;
        install|update|check|status)
                   cands=( ${(f)"$(_pve-toolbox_candidates modules)"} ) ;;
        config)    # config show <module>: 'show', then a single module name
                   case $nargs in
                       0) cands=(show) ;;
                       1) [[ $arg1 == show ]] || return 1
                          cands=( ${(f)"$(_pve-toolbox_candidates modules)"} ) ;;
                       *) return 1 ;;
                   esac ;;
        uninstall) cands=( ${(f)"$(_pve-toolbox_candidates installed)"} ) ;;
        *)         return 1 ;;   # menu, doctor, link, self-update take nothing
    esac

    # Drop what is already on the line, so completing a second module does
    # not re-offer the first.
    cands=( ${cands:|words} )
    (( $#cands )) || return 1
    compadd -a cands
}

_pve-toolbox "$@"
