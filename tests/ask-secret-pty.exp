# Keystroke-level drive of ask_secret over a real pty. Run through
# tests/ask-secret-pty.sh, which checks for expect and exports
# ASK_SECRET_PTY_VALUE, ASK_SECRET_PTY_DRIVER and ASK_EOF_PTY_DRIVER.
#
set timeout 10
log_user 0

set secret $env(ASK_SECRET_PTY_VALUE)
set driver $env(ASK_SECRET_PTY_DRIVER)

spawn bash $driver

expect {
    -re {token: } {}
    timeout { puts "FAIL timeout waiting for the token prompt"; exit 1 }
    eof     { puts "FAIL eof waiting for the token prompt"; exit 1 }
}
send -- "$secret\r"

# Accumulate every byte the pty produces from here on, not just what one
# `expect` match consumes, so the assertion below covers the whole session -
# the echo of what was typed (if any), the marker line, and anything in
# between - rather than one narrow window of it.
set transcript ""
expect {
    -re {.+} {
        append transcript $expect_out(buffer)
        exp_continue
    }
    eof {}
    timeout { puts "FAIL timeout waiting for the driver to finish"; exit 1 }
}

if {[string first $secret $transcript] != -1} {
    puts "FAIL the secret appeared on the pty: $transcript"
    exit 1
}
if {[string first "ASK_SECRET_PTY_MARKER=match" $transcript] == -1} {
    puts "FAIL ask_secret did not store the typed value: $transcript"
    exit 1
}

puts "ok  ask_secret's read -s keeps a typed secret off the pty"

# Ctrl-D on a terminal ends the prompt with an error, without the
# "run it in a terminal" advice meant for piped input.
spawn bash $env(ASK_EOF_PTY_DRIVER)
expect {
    -re {pick one \[} {}
    timeout { puts "FAIL timeout waiting for the pick one prompt"; exit 1 }
    eof     { puts "FAIL eof waiting for the pick one prompt"; exit 1 }
}
send -- "\004"
set transcript ""
expect {
    -re {.+} {
        append transcript $expect_out(buffer)
        exp_continue
    }
    eof {}
    timeout { puts "FAIL timeout waiting for the Ctrl-D driver to finish"; exit 1 }
}
set status [lindex [wait] 3]
if {$status == 0} {
    puts "FAIL Ctrl-D at a prompt exited 0: $transcript"
    exit 1
}
if {[string first {no answer for "pick one" (input closed); use -y and set SOME_KEY} $transcript] == -1} {
    puts "FAIL Ctrl-D did not report the unanswered prompt: $transcript"
    exit 1
}
if {[string first "run it in a terminal" $transcript] != -1} {
    puts "FAIL Ctrl-D at a terminal was told to run it in a terminal: $transcript"
    exit 1
}

puts "ok  Ctrl-D at a terminal prompt fails closed without the pipe hint"
