#!/usr/bin/make -f

PACKAGE_ROOT := debian/pve-toolbox
PACKAGE_LIB := $(PACKAGE_ROOT)/usr/lib/pve-toolbox
PACKAGE_VERSION := $(shell dpkg-parsechangelog -S Version)

%:
	dh $@

# PVE_TOOLBOX_ROOT would redirect the launcher at an installed tree; unset it
# so _man always reads share/man/pve-toolbox.1.in from this checkout, even if
# it leaked into the build environment. Render to a temp file outside the
# source tree first and move it into place only on success (mktemp files are
# 0600, so fix the mode before installing it), so a failing `_man` (caught by
# the `&&` chain, not swallowed by a later command) aborts the build without
# ever shipping a partial debian/pve-toolbox.1 or leaving one behind for a
# later rebuild to pick up; debian/clean also covers the successful-build
# case as a second line of defence. The EXIT trap removes the temp file on
# every path, including a failing chmod/mv, not only a failing _man.
override_dh_auto_build:
	tmp=$$(mktemp) && \
	trap 'rm -f "$$tmp"' EXIT && \
	env -u PVE_TOOLBOX_ROOT ./pve-toolbox _man > "$$tmp" && \
	chmod 0644 "$$tmp" && \
	mv "$$tmp" debian/pve-toolbox.1

# The release and CI workflows run the repository test suite before package
# construction. Running it through dh_auto_test would make tests/package.sh
# recursively invoke dpkg-buildpackage.
override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 pve-toolbox $(PACKAGE_ROOT)/usr/bin/pve-toolbox
	install -D -m 0755 scripts/pve-toolbox-native-notify \
		$(PACKAGE_ROOT)/usr/bin/pve-toolbox-native-notify
	install -D -m 0755 scripts/run-migrations.sh $(PACKAGE_LIB)/run-migrations.sh
	install -D -m 0755 scripts/retire-native-notifications.sh \
		$(PACKAGE_LIB)/retire-native-notifications.sh
	install -d -m 0755 $(PACKAGE_ROOT)/usr/share/pve-toolbox/notification-templates
	install -m 0644 share/notification-templates/pve-toolbox-*.hbs \
		$(PACKAGE_ROOT)/usr/share/pve-toolbox/notification-templates/
	install -d -m 0755 $(PACKAGE_LIB)/lib $(PACKAGE_LIB)/modules \
		$(PACKAGE_LIB)/migrations
	set -e; for migration in $(wildcard migrations/*.sh); do \
		install -m 0644 "$$migration" $(PACKAGE_LIB)/migrations/; \
	done
	install -m 0644 lib/common.sh lib/discord.sh lib/doctor.sh lib/pve.sh lib/report.sh lib/tui.sh \
		$(PACKAGE_LIB)/lib/
	set -e; for module in modules/*; do \
		name=$$(basename "$$module"); \
		case $$name in _*) continue ;; esac; \
		cp -a "$$module" "$(PACKAGE_LIB)/modules/$$name"; \
	done
	install -D -m 0644 debian/legacy/native-notifications/module.sh \
		$(PACKAGE_LIB)/modules/native-notifications/module.sh
	printf '%s\n' '$(PACKAGE_VERSION)' > $(PACKAGE_LIB)/VERSION
	install -D -m 0644 completions/pve-toolbox.bash \
		$(PACKAGE_ROOT)/usr/share/bash-completion/completions/pve-toolbox
	install -D -m 0644 completions/_pve-toolbox \
		$(PACKAGE_ROOT)/usr/share/zsh/vendor-completions/_pve-toolbox
	install -d -m 0750 $(PACKAGE_ROOT)/etc/pve-toolbox
	install -d -m 0755 $(PACKAGE_ROOT)/var/lib/pve-toolbox

override_dh_fixperms:
	dh_fixperms
	chmod 0750 $(PACKAGE_ROOT)/etc/pve-toolbox
