#!/usr/bin/env bash
#
# pve-toolbox - interactive launcher for custom Proxmox scripts.
#
#   pve-toolbox                    interactive menu
#   pve-toolbox ui                 full-screen menu (needs whiptail)
#   pve-toolbox list [tag]         list modules
#   pve-toolbox install <mod>...   install specific modules
#   pve-toolbox update [mod]...    update (all installed if none given)
#   pve-toolbox check [mod]...     report available updates, change nothing
#   pve-toolbox status [mod]       detailed status
#   pve-toolbox doctor             read-only host and module health audit
#   pve-toolbox lxc-update [ID]...  update local running Debian/Ubuntu containers
#   pve-toolbox uninstall <mod>...
#   pve-toolbox link               symlink into /usr/local/bin + completions
#   pve-toolbox self-update        git pull this checkout
#   pve-toolbox --version          print the installed version
#
# Flags: -y/--yes non-interactive, -f/--force, --json, --quiet,
#        -V/--version, -h/--help
# LXC update flags: --dry-run, --allow-removals, --notify (interactive only)
#
set -euo pipefail

# `pve-toolbox link` symlinks this file into TOOLBOX_BIN_DIR, so BASH_SOURCE is
# the symlink, not the checkout. Walk the chain to find where the libs really are.
_src="${BASH_SOURCE[0]}"
while [[ -L $_src ]]; do
    _dir="$(cd -- "$(dirname -- "$_src")" && pwd)"
    _src="$(readlink -- "$_src")"
    [[ $_src != /* ]] && _src="$_dir/$_src"
done
_dir="$(cd -- "$(dirname -- "$_src")" && pwd -P)"
_src="$_dir/$(basename -- "$_src")"
# The Debian package splits the launcher in /usr/bin from its code in
# /usr/lib. PVE_TOOLBOX_ROOT makes that layout testable without installing a
# package onto the host running the tests.
TOOLBOX_PACKAGED=0
if [[ $_src == /usr/bin/pve-toolbox || -n ${PVE_TOOLBOX_ROOT:-} ]]; then
    TOOLBOX_PACKAGED=1
    TOOLBOX_ROOT="${PVE_TOOLBOX_ROOT:-/usr/lib/pve-toolbox}"
else
    TOOLBOX_ROOT="$_dir"
fi
unset _src _dir
MODULE_DIR="$TOOLBOX_ROOT/modules"

if [[ -r $TOOLBOX_ROOT/VERSION ]]; then
    IFS= read -r TOOLBOX_VERSION < "$TOOLBOX_ROOT/VERSION"
else
    TOOLBOX_VERSION="unknown"
fi

# shellcheck source=lib/common.sh
source "$TOOLBOX_ROOT/lib/common.sh"
# shellcheck source=lib/pve.sh
source "$TOOLBOX_ROOT/lib/pve.sh"
# shellcheck source=lib/report.sh
source "$TOOLBOX_ROOT/lib/report.sh"
# shellcheck source=lib/doctor.sh
source "$TOOLBOX_ROOT/lib/doctor.sh"

FORCE=0
OUTPUT_JSON=0
OUTPUT_QUIET=0

usage_error() {
    printf '%s error:%s %s\n' "$c_red$c_bold" "$c_reset" "$*" >&2
    exit 64
}

# --------------------------------------------------------------- discovery --

discover() {
    MODULES=()
    local d
    for d in "$MODULE_DIR"/*/; do
        [[ -f "$d/module.sh" ]] || continue
        local name; name=$(basename "$d")
        [[ $name == _* ]] && continue
        MODULES+=("$name")
    done
    if [[ ${#MODULES[@]} -eq 0 ]]; then
        die "no modules found in $MODULE_DIR"
    fi
}

# Read metadata without polluting the current shell.
meta() { # meta <module> <VAR>
    (
        set +u
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$1/module.sh"
        printf '%s' "${!2}"
    )
}

# Run a module function in a subshell so module globals stay isolated.
run_module() { # run_module <module> <function> [args...]
    local mod=$1 fn=$2; shift 2
    [[ -f "$MODULE_DIR/$mod/module.sh" ]] || usage_error "unknown module: $mod"
    (
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$mod/module.sh"
        if ! declare -F "$fn" >/dev/null; then
            if [[ $fn == module_status_long ]] && declare -F module_status >/dev/null; then
                local rc=0
                module_status || rc=$?
                echo
                exit "$rc"
            fi
            die "module $mod does not implement $fn"
        fi
        "$fn" "$@"
    )
}

module_has_function() { # module_has_function <module> <function>
    local mod=$1 fn=$2
    [[ -f "$MODULE_DIR/$mod/module.sh" ]] || return 1
    (
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$mod/module.sh"
        declare -F "$fn" >/dev/null
    )
}

status_line() { # status_line <module> -> short status, "not installed" if it is not
    local st
    st=$(run_module "$1" module_status 2>/dev/null) || true
    printf '%s' "${st:-not installed}"
}

# The one reading of "installed", for the menu, the ui, completion and the
# command line. module_status is contracted to exit 1 when a module is not
# installed, and a module that prints nothing at all is not installed either.
is_installed() { # is_installed <module>
    [[ $(status_line "$1") != "not installed" ]]
}

# ------------------------------------------------------------------- menu --

print_table() {
    local i=1 m title desc st
    printf '\n%s  #  %-24s %-11s %s%s\n' "$c_bold" "MODULE" "STATUS" "DESCRIPTION" "$c_reset"
    for m in "${MODULES[@]}"; do
        title=$(meta "$m" MODULE_TITLE)
        desc=$(meta "$m" MODULE_DESC)
        st=$(status_line "$m")
        local mark="   "
        [[ " ${SELECTED[*]:-} " == *" $m "* ]] && mark=" ${c_green}*${c_reset} "
        if [[ $st == "not installed" ]]; then
            printf '%s%2d) %-24s %s%-11s%s %s\n' "$mark" "$i" "$title" "$c_dim" "-" "$c_reset" "$desc"
        else
            printf '%s%2d) %-24s %s%-11s%s %s\n' "$mark" "$i" "$title" "$c_green" "${st%% *}" "$c_reset" "$desc"
        fi
        i=$((i + 1))
    done
    echo
}

menu() {
    discover
    SELECTED=()
    while true; do
        printf '\n%s pve-toolbox %s%s\n' "$c_bold$c_blue" "$(hostname -s)" "$c_reset"
        print_table
        dim "  numbers toggle selection (e.g. '1 3'), then:"
        printf '  %si%s install/reconfigure selected   %su%s update all installed\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sc%s check for updates              %ss%s status of selected\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sx%s uninstall selected             %sq%s quit\n\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sl%s update LXC container packages\n' "$c_bold" "$c_reset"
        printf '  %sa%s configure automatic LXC updates\n\n' "$c_bold" "$c_reset"

        local reply
        read -r -p "> " reply || { echo; return 0; }
        [[ -z $reply ]] && continue

        case ${reply,,} in
            q|quit|exit) return 0 ;;
            l|lxc-update) cmd_lxc_update || warn "LXC update did not complete" ;;
            a|lxc-schedule)
                step "Configure automatic LXC updates"
                run_module lxc-update module_status_long || true
                echo
                run_module lxc-update module_install \
                    || warn "LXC automatic-update configuration did not complete" ;;
            i|install)
                [[ ${#SELECTED[@]} -eq 0 ]] && { warn "nothing selected"; continue; }
                local m; for m in "${SELECTED[@]}"; do
                    step "Installing $(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_install || warn "$m did not complete"
                done
                SELECTED=() ;;
            u|update)
                local m; for m in "${MODULES[@]}"; do
                    is_installed "$m" || continue
                    step "Updating $(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_update || warn "$m update failed"
                done ;;
            c|check)
                local m; for m in "${MODULES[@]}"; do
                    is_installed "$m" || continue
                    step "$(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_update --check || true
                done ;;
            s|status)
                local list=() m
                if [[ ${#SELECTED[@]} -gt 0 ]]; then list=("${SELECTED[@]}"); else list=("${MODULES[@]}"); fi
                for m in "${list[@]}"; do
                    step "$(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_status_long || true
                done ;;
            x|uninstall)
                [[ ${#SELECTED[@]} -eq 0 ]] && { warn "nothing selected"; continue; }
                warn "about to uninstall: ${SELECTED[*]}"
                if confirm "are you sure?" "n"; then
                    local m; for m in "${SELECTED[@]}"; do
                        step "Removing $(meta "$m" MODULE_TITLE)"
                        run_module "$m" module_uninstall || warn "$m removal failed"
                    done
                    SELECTED=()
                fi ;;
            *)
                local tok idx m
                for tok in $reply; do
                    [[ $tok =~ ^[0-9]+$ ]] || { warn "not a number: $tok"; continue; }
                    idx=$((tok - 1))
                    [[ $idx -lt 0 || $idx -ge ${#MODULES[@]} ]] && { warn "out of range: $tok"; continue; }
                    m=${MODULES[$idx]}
                    if [[ " ${SELECTED[*]:-} " == *" $m "* ]]; then
                        local keep=() k
                        for k in "${SELECTED[@]}"; do [[ $k != "$m" ]] && keep+=("$k"); done
                        SELECTED=("${keep[@]:-}")
                        [[ -z ${SELECTED[0]:-} ]] && SELECTED=()
                    else
                        SELECTED+=("$m")
                    fi
                done ;;
        esac
    done
}

# --------------------------------------------------------------- commands --

cmd_lxc_update() {
    bash "$MODULE_DIR/lxc-update/run.sh" "$@"
}

cmd_list() {
    discover
    local tag=${1:-} m
    for m in "${MODULES[@]}"; do
        [[ -n $tag && " $(meta "$m" MODULE_TAGS) " != *" $tag "* ]] && continue
        printf '%s%-24s%s %s\n' "$c_bold" "$m" "$c_reset" "$(meta "$m" MODULE_DESC)"
        printf '  %sstatus: %s | tags: %s%s\n' \
            "$c_dim" "$(status_line "$m")" "$(meta "$m" MODULE_TAGS)" "$c_reset"
    done
}

cmd_each() { # cmd_each <function> [--check] <modules...>
    local fn=$1; shift
    local extra=""
    local failed=0
    [[ ${1:-} == --check ]] && { extra=--check; shift; }
    discover
    local list=("$@") m
    if [[ ${#list[@]} -eq 0 ]]; then
        for m in "${MODULES[@]}"; do
            is_installed "$m" || continue
            list+=("$m")
        done
    fi
    [[ ${#list[@]} -eq 0 ]] && { warn "no installed modules"; return 0; }
    for m in "${list[@]}"; do
        [[ -f "$MODULE_DIR/$m/module.sh" ]] || usage_error "unknown module: $m"
    done
    for m in "${list[@]}"; do
        step "$(meta "$m" MODULE_TITLE)"
        if [[ $fn == module_status_long ]]; then
            # module_status exits 1 to mean "not installed", which is the
            # answer status was asked for. Naming a module that is not
            # installed is a legitimate thing to do; it is not a failure.
            run_module "$m" "$fn" || true
        elif [[ -n $extra ]]; then
            if ! run_module "$m" "$fn" "$extra"; then
                warn "$m failed"
                failed=1
            fi
        else
            if ! run_module "$m" "$fn"; then
                warn "$m failed"
                failed=1
            fi
        fi
    done
    return "$failed"
}

cmd_module_report() { # cmd_module_report <status|check> <function> [--check] <modules...>
    local command=$1 fn=$2; shift 2
    local extra="" explicit=1
    [[ ${1:-} == --check ]] && { extra=--check; shift; }
    local list=("$@") m output rc state summary
    [[ ${#list[@]} -eq 0 ]] && explicit=0

    report_reset "$command"
    discover
    if [[ $explicit -eq 0 ]]; then
        for m in "${MODULES[@]}"; do
            is_installed "$m" || continue
            list+=("$m")
        done
    fi
    for m in "${list[@]}"; do
        [[ -f "$MODULE_DIR/$m/module.sh" ]] || usage_error "unknown module: $m"
        if [[ $command == status ]] && ! is_installed "$m"; then
            report_add skipped "module.$m.status" "module is not installed"
            continue
        fi

        output=""; rc=0
        if [[ -n $extra ]]; then
            output=$(run_module "$m" "$fn" "$extra" 2>&1) || rc=$?
        else
            output=$(run_module "$m" "$fn" 2>&1) || rc=$?
        fi
        if [[ $rc -ne 0 ]]; then
            report_add fail "module.$m.$command" "$command failed with exit $rc" "$output"
            continue
        fi

        state=pass
        summary="$command completed"
        if [[ $command == check && $output == *"update available:"* ]]; then
            state=warn
            summary="update available"
        elif [[ $command == check && $output == *" is older than "* ]]; then
            state=warn
            summary="configured release is older than the installed version"
        fi
        report_add "$state" "module.$m.$command" "$summary" "$output"
    done

    local exit_code
    exit_code=$(report_exit_code)
    if [[ $OUTPUT_QUIET -eq 0 ]]; then
        report_render_json "$exit_code"
    fi
    return "$exit_code"
}

cmd_doctor() {
    doctor_reset
    doctor_run_core

    discover
    local m status output rc
    for m in "${MODULES[@]}"; do
        status=""; rc=0
        output=$(run_module "$m" module_status 2>/dev/null) || rc=$?
        status=${output:-not installed}
        [[ $status == "not installed" ]] && continue
        if [[ $rc -ne 0 ]]; then
            doctor_result fail "module.$m.status" \
                "installed module status failed with exit $rc"
            continue
        fi
        doctor_result pass "module.$m.status" "installed: $status"

        module_has_function "$m" module_doctor || continue
        output=""; rc=0
        output=$(DOCTOR_EMIT=1 DOCTOR_PREFIX="module.$m." \
            run_module "$m" module_doctor 2>&1) || rc=$?
        doctor_import_module "$m" "$rc" "$output"
    done

    local exit_code
    exit_code=$(report_exit_code)
    if [[ $OUTPUT_QUIET -eq 1 ]]; then
        return "$exit_code"
    fi
    if [[ $OUTPUT_JSON -eq 1 ]]; then
        report_render_json "$exit_code"
        return "$exit_code"
    fi
    doctor_render
}

# ------------------------------------------------------------------- ui --

# Modules prompt and print while they work, which cannot happen inside a
# whiptail box, so the widgets only ever choose. Once something is chosen the
# screen is handed back and the module runs exactly as it does from the
# command line.

# Answers through UI_PICKED instead of stdout, so only the checklist is ever
# inside a $( ). A widget called in a capture draws into the pipe rather than
# onto the screen, and the box is then invisible but still waiting.
UI_PICKED=""

ui_pick() { # ui_pick <title> <all|installed> <on|off> -> sets UI_PICKED
    local title=$1 pool=$2 default=$3
    local -a items=()
    local m st
    UI_PICKED=""

    # One module_status per module, and some of them shell out to zpool.
    tui_info "Reading module status..."
    for m in "${MODULES[@]}"; do
        st=$(status_line "$m")
        [[ $pool == installed && $st == "not installed" ]] && continue
        items+=("$m" "$(meta "$m" MODULE_TITLE) - $st" "$default")
    done

    if [[ ${#items[@]} -eq 0 ]]; then
        tui_msg "$title" "No modules are installed."
        return 1
    fi
    UI_PICKED=$(tui_checklist "$title" \
        "Space toggles, Enter confirms, Esc goes back." "${items[@]}")
}

ui_run() { # ui_run <fn> <modules> [extra-arg]
    local fn=$1 picked=$2 extra=${3:-} m
    local -a mods=()

    # Collect the whole list before running anything. `done <<<` redirects
    # stdin for the entire loop body, so a module's ask/ask_secret/confirm
    # would read the remains of this list rather than the terminal - and since
    # ask swallows a failed read and keeps its default, every prompt in an
    # install would flash past unanswered.
    while IFS= read -r m; do
        [[ -n $m ]] && mods+=("$m")
    done <<<"$picked"

    tui_clear
    for m in "${mods[@]}"; do
        step "$(meta "$m" MODULE_TITLE)"
        if [[ $fn == module_status_long ]]; then
            # module_status exits 1 to mean "not installed". That is what the
            # status action is there to report, not a failure to announce.
            run_module "$m" "$fn" || true
        elif [[ -n $extra ]]; then
            run_module "$m" "$fn" "$extra" || warn "$m failed"
        else
            run_module "$m" "$fn" || warn "$m failed"
        fi
    done
    echo
    read -rsn1 -p "press any key to go back to the menu " _ || true
    echo
}

ui_action() { # ui_action <title> <fn> <pool> <default> [extra-arg]
    local title=$1 fn=$2 pool=$3 default=$4 extra=${5:-}
    ui_pick "$title" "$pool" "$default" || return 0
    [[ -z $UI_PICKED ]] && return 0
    if [[ $fn == module_uninstall ]]; then
        tui_yesno "Uninstall" \
            "About to remove:"$'\n\n'"$UI_PICKED"$'\n\n'"Continue?" || return 0
    fi
    ui_run "$fn" "$UI_PICKED" "$extra"
}

cmd_ui() {
    [[ -t 0 && -t 1 ]] || die "ui needs a terminal, try 'pve-toolbox list'"
    # whiptail exits 1 on a terminal it cannot draw on, which is also its exit
    # code for Cancel. There is no telling the two apart once a widget has run,
    # and the ui would look like it quit the instant it started, so rule the
    # case out up front.
    case ${TERM:-} in
        ""|dumb|unknown) die "ui needs a capable terminal, TERM is '${TERM:-unset}'" ;;
    esac
    # shellcheck source=lib/tui.sh
    source "$TOOLBOX_ROOT/lib/tui.sh"
    tui_detect || die "ui needs whiptail or dialog (apt install whiptail)"
    discover
    local host
    host=$(hostname -s 2>/dev/null) || host=""
    TUI_BACKTITLE="pve-toolbox${host:+ @ $host}"

    local choice
    while true; do
        choice=$(tui_menu "pve-toolbox" "Arrows move, Enter chooses, Esc quits." \
            install   "Install or reconfigure modules" \
            update    "Update installed modules" \
            check     "Check for updates, change nothing" \
            status    "Show detailed status" \
            uninstall "Remove installed modules" \
            lxc-update "Update LXC container packages" \
            lxc-schedule "Configure automatic LXC updates" \
            quit      "Exit") || { tui_clear; return 0; }
        case $choice in
            install)   ui_action "Install / reconfigure" module_install     all       off ;;
            update)    ui_action "Update"                module_update      installed on  ;;
            check)     ui_action "Check for updates"     module_update      installed on --check ;;
            status)    ui_action "Status"                module_status_long all       on  ;;
            uninstall) ui_action "Uninstall"             module_uninstall   installed off ;;
            lxc-update) ui_lxc_update ;;
            lxc-schedule) ui_lxc_schedule ;;
            quit)      tui_clear; return 0 ;;
        esac
    done
}

ui_lxc_update() {
    local picked option ids="" rc=0
    local -a flags=() targets=()
    picked=$(tui_checklist "LXC package updates" "Choose options. Execution asks for confirmation." \
        dry-run "Preview only (cached package indexes)" on \
        allow-removals "Allow package removals and cleanup" off \
        notify "Send Discord report" off) || return 0
    while IFS= read -r option; do
        [[ -z $option ]] || flags+=("--$option")
    done <<<"$picked"
    tui_clear
    ask ids "Container IDs, space-separated; all eligible when blank" ""
    read -r -a targets <<<"$ids"
    cmd_lxc_update "${flags[@]}" "${targets[@]}" || rc=$?
    [[ $rc == 0 ]] || warn "LXC update returned $rc; inspect the results above"
    read -rsn1 -p "press any key to go back to the menu " _ || true
}

ui_lxc_schedule() {
    tui_clear
    step "Configure automatic LXC updates"
    run_module lxc-update module_status_long || true
    echo
    run_module lxc-update module_install \
        || warn "LXC automatic-update configuration did not complete"
    echo
    read -rsn1 -p "press any key to go back to the menu " _ || true
    echo
}

cmd_link() {
    [[ $TOOLBOX_PACKAGED -eq 0 ]] \
        || die "this install is managed by apt; do not replace dpkg-owned paths"
    require_root
    ln -sfn "$TOOLBOX_ROOT/pve-toolbox" "$TOOLBOX_BIN_DIR/pve-toolbox"
    ok "linked $TOOLBOX_BIN_DIR/pve-toolbox -> $TOOLBOX_ROOT/pve-toolbox"
    link_completions
}

# Symlinked, not copied, so self-update refreshes them with the rest of the
# checkout. Only into directories the shell already scans: creating one would
# mean guessing at a shell that is not installed.
link_completions() {
    local pair dest src
    for pair in \
        "$TOOLBOX_BASH_COMPLETION_DIR/pve-toolbox:completions/pve-toolbox.bash" \
        "$TOOLBOX_ZSH_COMPLETION_DIR/_pve-toolbox:completions/_pve-toolbox"
    do
        dest=${pair%%:*}; src="$TOOLBOX_ROOT/${pair#*:}"
        if [[ ! -d ${dest%/*} ]]; then
            dim "  skipped ${dest%/*}, not present"
            continue
        fi
        ln -sfn "$src" "$dest"
        ok "linked $dest"
    done
    dim "  completions load in new shells"
}

# Candidates for the completion scripts. Separate from `list` because that
# prints a status per module, and a TAB press should not shell out to zpool.
cmd_complete() { # cmd_complete <commands|modules|installed|tags>
    local m
    local -a tags
    case ${1:-} in
        commands)
            printf '%s\n' menu ui list install update check status doctor uninstall \
                lxc-update link self-update ;;
        modules)
            discover; printf '%s\n' "${MODULES[@]}" ;;
        installed)
            discover
            # An if, not an &&: with nothing installed the last iteration
            # would otherwise decide the exit status.
            for m in "${MODULES[@]}"; do
                if is_installed "$m"; then printf '%s\n' "$m"; fi
            done ;;
        tags)
            discover
            for m in "${MODULES[@]}"; do
                read -r -a tags <<<"$(meta "$m" MODULE_TAGS)"
                if [[ ${#tags[@]} -gt 0 ]]; then
                    printf '%s\n' "${tags[@]}"
                fi
            done | sort -u ;;
        *)  usage_error "unknown completion target: ${1:-}" ;;
    esac
}

cmd_self_update() {
    [[ $TOOLBOX_PACKAGED -eq 0 ]] \
        || die "this install is managed by apt; run: apt update && apt upgrade pve-toolbox"
    [[ -d "$TOOLBOX_ROOT/.git" ]] || die "$TOOLBOX_ROOT is not a git checkout"
    command -v git >/dev/null 2>&1 || die "git not installed"
    info "pulling $TOOLBOX_ROOT"
    git -C "$TOOLBOX_ROOT" pull --ff-only
    ok "now at $(git -C "$TOOLBOX_ROOT" describe --always --dirty)"
}

# Print the header block, stopping at the first non-comment line, so the
# range never has to be kept in sync with the code underneath it.
usage() { awk 'NR < 3 { next } !/^#/ { exit } { sub(/^# ?/, ""); print }' "$0"; }

# ------------------------------------------------------------------- main --

ARGS=()
LXC_FLAGS=()
while [[ $# -gt 0 ]]; do
    case $1 in
        -y|--yes)   ASSUME_YES=1 ;;
        -f|--force) FORCE=1 ;;
        --json)     OUTPUT_JSON=1 ;;
        --quiet)    OUTPUT_QUIET=1 ;;
        --dry-run|--allow-removals|--notify) LXC_FLAGS+=("$1") ;;
        -V|--version) printf 'pve-toolbox %s\n' "$TOOLBOX_VERSION"; exit 0 ;;
        -h|--help)  usage; exit 0 ;;
        --)         shift; ARGS+=("$@"); break ;;
        -*)         usage_error "unknown flag: $1" ;;
        *)          ARGS+=("$1") ;;
    esac
    shift
done
[[ $OUTPUT_JSON -eq 0 || $OUTPUT_QUIET -eq 0 ]] \
    || usage_error "--json and --quiet cannot be used together"

command_name=${ARGS[0]:-menu}
[[ ${#LXC_FLAGS[@]} == 0 || $command_name == lxc-update ]] \
    || usage_error "LXC update flags apply only to lxc-update"
if [[ $OUTPUT_JSON -eq 1 || $OUTPUT_QUIET -eq 1 ]]; then
    case $command_name in
        status|check|doctor) ;;
        *) usage_error "--json and --quiet are supported by status, check, and doctor" ;;
    esac
    c_reset=""; c_bold=""; c_dim=""; c_red=""; c_green=""; c_yellow=""; c_blue=""
fi
export ASSUME_YES FORCE TOOLBOX_ROOT TOOLBOX_PACKAGED

case $command_name in
    menu)        menu ;;
    lxc-update)  exec bash "$MODULE_DIR/lxc-update/run.sh" "${LXC_FLAGS[@]}" "${ARGS[@]:1}" ;;
    list)        cmd_list "${ARGS[@]:1}" ;;
    install)     [[ ${#ARGS[@]} -lt 2 ]] && usage_error "install needs a module name"
                 cmd_each module_install "${ARGS[@]:1}" ;;
    update)      cmd_each module_update "${ARGS[@]:1}" ;;
    check)       if [[ $OUTPUT_JSON -eq 1 || $OUTPUT_QUIET -eq 1 ]]; then
                     cmd_module_report check module_update --check "${ARGS[@]:1}"
                 else
                     cmd_each module_update --check "${ARGS[@]:1}"
                 fi ;;
    status)      if [[ $OUTPUT_JSON -eq 1 || $OUTPUT_QUIET -eq 1 ]]; then
                     cmd_module_report status module_status_long "${ARGS[@]:1}"
                 else
                     cmd_each module_status_long "${ARGS[@]:1}"
                 fi ;;
    doctor)      [[ ${#ARGS[@]} -eq 1 ]] || usage_error "doctor takes no arguments"
                 cmd_doctor ;;
    uninstall)   [[ ${#ARGS[@]} -lt 2 ]] && usage_error "uninstall needs a module name"
                 cmd_each module_uninstall "${ARGS[@]:1}" ;;
    ui)          cmd_ui ;;
    link)        cmd_link ;;
    _complete)   cmd_complete "${ARGS[@]:1}" ;;
    self-update) cmd_self_update ;;
    *)           usage_error "unknown command: ${ARGS[0]} (try --help)" ;;
esac
