#!/usr/bin/env bash
#
# pve-toolbox - modular administration toolbox for Proxmox VE hosts. Run 'pve-toolbox help'.
#
set -euo pipefail

# `pve-toolbox link` symlinks this file into TOOLBOX_BIN_DIR, so BASH_SOURCE is
# the symlink, not the checkout. Walk the chain to find where the libs really are.
_src="${BASH_SOURCE[0]}"
while [[ -L $_src ]]; do
    _dir="$(cd -- "$(dirname -- "$_src")" && pwd)"
    _src="$(readlink -- "$_src")"
    [[ $_src != /* ]] && _src="$_dir/$_src"
done
_dir="$(cd -- "$(dirname -- "$_src")" && pwd -P)"
_src="$_dir/$(basename -- "$_src")"
# The Debian package splits the launcher in /usr/bin from its code in
# /usr/lib. PVE_TOOLBOX_ROOT makes that layout testable without installing a
# package onto the host running the tests.
TOOLBOX_PACKAGED=0
if [[ $_src == /usr/bin/pve-toolbox || -n ${PVE_TOOLBOX_ROOT:-} ]]; then
    TOOLBOX_PACKAGED=1
    TOOLBOX_ROOT="${PVE_TOOLBOX_ROOT:-/usr/lib/pve-toolbox}"
else
    TOOLBOX_ROOT="$_dir"
fi
unset _src _dir
MODULE_DIR="$TOOLBOX_ROOT/modules"

if [[ -r $TOOLBOX_ROOT/VERSION ]]; then
    IFS= read -r TOOLBOX_VERSION < "$TOOLBOX_ROOT/VERSION"
else
    TOOLBOX_VERSION="unknown"
fi

# shellcheck source=lib/common.sh
source "$TOOLBOX_ROOT/lib/common.sh"
# shellcheck source=lib/pve.sh
source "$TOOLBOX_ROOT/lib/pve.sh"
# shellcheck source=lib/report.sh
source "$TOOLBOX_ROOT/lib/report.sh"
# shellcheck source=lib/doctor.sh
source "$TOOLBOX_ROOT/lib/doctor.sh"

FORCE=0
# Never inherit selection authorization from the environment.
TOOLBOX_UPDATE_EXPLICIT=0
OUTPUT_JSON=0
OUTPUT_QUIET=0

# Levenshtein distance between two words, ignoring case.
_cli_distance() { # _cli_distance <a> <b> -> distance
    local a=${1,,} b=${2,,} i j cost
    local -a prev=() cur=()
    for ((j = 0; j <= ${#b}; j++)); do prev[j]=$j; done
    for ((i = 1; i <= ${#a}; i++)); do
        cur=([0]=$i)
        for ((j = 1; j <= ${#b}; j++)); do
            cost=1
            [[ ${a:i-1:1} != "${b:j-1:1}" ]] || cost=0
            cur[j]=$((prev[j] + 1))
            if ((cur[j - 1] + 1 < cur[j])); then cur[j]=$((cur[j - 1] + 1)); fi
            if ((prev[j - 1] + cost < cur[j])); then cur[j]=$((prev[j - 1] + cost)); fi
        done
        prev=("${cur[@]}")
    done
    printf '%s' "${prev[${#b}]}"
}

# What the operator probably meant. A candidate that is the only one starting
# with the word wins outright; otherwise every candidate within two edits
# qualifies, closest first and then in the order given. At most three.
cli_suggest() { # cli_suggest <word> <candidate>... -> up to 3, one per line
    local word=$1 c d n=0
    local -a prefix=() scored=()
    shift
    [[ -n $word ]] || return 0
    for c in "$@"; do
        [[ ${c,,} != "${word,,}"* ]] || prefix+=("$c")
        # The length difference is a lower bound on the edit distance, so a
        # candidate more than two characters longer or shorter than the word
        # can never score; skip the expensive comparison for it. This keeps a
        # pathological word (a very long bogus flag or argument) fast against
        # every candidate list.
        if ((${#word} > ${#c} + 2 || ${#c} > ${#word} + 2)); then
            n=$((n + 1))
            continue
        fi
        d=$(_cli_distance "$word" "$c")
        if ((d <= 2)); then scored+=("$d $n $c"); fi
        n=$((n + 1))
    done
    if ((${#prefix[@]} == 1)); then
        printf '%s\n' "${prefix[0]}"
        return 0
    fi
    ((${#scored[@]})) || return 0
    printf '%s\n' "${scored[@]}" | sort -n -k1,1 -k2,2 | head -n 3 | cut -d' ' -f3-
}

# Every usage error: the error line, what was probably meant, and where the
# usage is documented. Exit 64 (EX_USAGE).
cli_usage_error() { # cli_usage_error <message> [<help topic>] [suggestion]...
    local msg=$1 topic=${2:-} list
    shift
    (($# == 0)) || shift
    printf '%s error:%s %s\n' "$e_red$e_bold" "$e_reset" "$msg" >&2
    if (($#)); then
        list=$(printf '%s, ' "$@")
        printf 'did you mean: %s?\n' "${list%, }" >&2
    fi
    printf "run 'pve-toolbox help%s' for usage\n" "${topic:+ $topic}" >&2
    exit 64
}

usage_error() {
    cli_usage_error "$*"
}

cli_unknown_module() { # cli_unknown_module <name> -> exits 64 with suggestions
    local -a s=()
    discover
    mapfile -t s < <(cli_suggest "$1" "${MODULES[@]}")
    cli_usage_error "unknown module: $1" "${command_name:-}" "${s[@]}"
}

# ------------------------------------------------------------ command table --
#
# The one description of the command line. Help, flag validation,
# suggestions, completions and the generated man page all read these; add a
# command here first. Data only: nothing runs while it is defined.

CLI_COMMANDS=(menu ui list install update check status doctor config lxc-update uninstall link self-update help)
# Internal commands the completion scripts (and the packaging build, for
# _man) call. Never shown or suggested, but not unknown either.
CLI_HIDDEN=(_complete _man)

CLI_GLOBAL_FLAGS=("-y|--yes" "-f|--force" "--color=WHEN" "-V|--version" "-h|--help")
declare -A CLI_GLOBAL_DESC=(
    ["-y|--yes"]="non-interactive: take configured values and defaults"
    ["-f|--force"]="force reinstall or redownload where a module supports it"
    ["--color=WHEN"]="colour output: auto (default), always or never; NO_COLOR also disables it; --json or --quiet always force it off"
    ["-V|--version"]="print the installed version"
    ["-h|--help"]="show help; with a command, that command's help"
)
declare -A CLI_FLAG_DESC=(
    [--json]="emit versioned, machine-readable JSON"
    [--quiet]="print nothing; return only the standardized exit status. This cannot be combined with --json"
    [--dry-run]="preview using cached package indexes; change nothing"
    [--allow-removals]="allow package removals and cleanup"
    [--notify]="send a Discord report after the run"
)
declare -A CLI_SUMMARY=(
    [menu]="interactive menu (default when no command is given)"
    [ui]="full-screen menu (needs whiptail or dialog)"
    [list]="list modules and their status, optionally filtered by tag"
    [install]="install or reconfigure modules"
    [update]="update modules (all installed when none named)"
    [check]="report available updates, change nothing"
    [status]="show detailed module status"
    [doctor]="read-only host and module health audit"
    [config]="show a module's saved configuration, secrets hidden"
    [lxc-update]="update running Debian/Ubuntu containers on this node"
    [uninstall]="remove modules after confirmation"
    [link]="link a git checkout into /usr/local/bin and completions"
    [self-update]="update a git checkout (packaged installs use apt)"
    [help]="show help for a command"
)
declare -A CLI_USAGE=(
    [menu]="menu"
    [ui]="ui"
    [list]="list [--json] [tag]"
    [install]="install <module>..."
    [update]="update [module]..."
    [check]="check [--json|--quiet] [module]..."
    [status]="status [--json|--quiet] [module]..."
    [doctor]="doctor [--json|--quiet]"
    [config]="config show [--json] <module>"
    [lxc-update]="lxc-update [--dry-run] [--allow-removals] [--notify] [ID]..."
    [uninstall]="uninstall <module>..."
    [link]="link"
    [self-update]="self-update"
    [help]="help [command]"
)
declare -A CLI_FLAGS=(
    [list]="--json"
    [check]="--json --quiet"
    [status]="--json --quiet"
    [doctor]="--json --quiet"
    [config]="--json"
    [lxc-update]="--dry-run --allow-removals --notify"
)
# Global flags a command's own runner refuses (lxc-update execution needs an
# interactive confirmation, so --yes and --force are rejected there). Help and
# completion leave them out; the launcher still accepts and passes them, so
# the runner remains the one that explains the refusal.
declare -A CLI_NO_GLOBALS=([lxc-update]="-y|--yes -f|--force")
declare -A CLI_ROOT=([install]=1 [update]=1 [uninstall]=1 [lxc-update]=1 [link]=1 [config]=1)
declare -A CLI_DESC=(
    [lxc-update]="Update running Debian/Ubuntu containers on the local PVE 9 host. Requires interactive confirmation. Use --dry-run for a cached preview, --allow-removals to enable package removals and cleanup, and --notify for a Discord report. Saved exclusions always apply. No automatic reboots, backups, rollback, or distribution upgrades. Package scripts may restart services. Use 'pve-toolbox install lxc-update' to configure an optional node-local systemd schedule. Scheduled runs update every eligible local container with the non-removing policy, never catch up after downtime, and can report every batch to Discord when explicitly enabled. Use 'pve-toolbox status lxc-update' to inspect timer health and recent results."
    [doctor]="The audit covers host, cluster, storage and installed modules. Exit status 0 when healthy, 2 when warnings are present, 1 when a check fails, 69 when every meaningful check is unsupported."
    [link]="Packaged installs refuse this command."
    [config]="Only keys the module declares public show their value, as stored and after the usual cleanup (credential URLs redacted, newlines joined, control characters replaced); every other key shows only whether it is set. The stored KEY='value' lines are parsed, nothing is expanded, and the file is never run; a line outside that form refuses the file. A configuration file or directory that is a symbolic link, is not owned by root, or is writable by group or others is refused too, before anything is read."
)
declare -A CLI_EXAMPLES=(
    [list]=$'pve-toolbox list\npve-toolbox list storage\npve-toolbox list --json'
    [install]=$'pve-toolbox install config-backup\npve-toolbox -y install zfs-scrub'
    [status]=$'pve-toolbox status\npve-toolbox status --json zfs-scrub'
    [check]='pve-toolbox check --quiet'
    [doctor]='pve-toolbox doctor --json'
    [config]=$'pve-toolbox config show zfs-scrub\npve-toolbox config show --json config-backup'
    [lxc-update]='pve-toolbox lxc-update --dry-run 101 102'
    [help]='pve-toolbox help status'
)

# fold -s breaks after the space, so strip what it leaves at line ends. One
# place for that fix, shared by the free-text CLI_DESC paragraph below and by
# cli_print_option, so a long fact never overruns the terminal in either.
cli_fold() { # cli_fold <width> <text> -> wrapped, no trailing spaces
    fold -s -w "$1" <<<"$2" | sed 's/ *$//'
}

# Prints one "  label           description" row, wrapping the description at
# the same total width CLI_DESC uses (78 columns) and indenting continuation
# lines to line up under the description column, so a long option fact wraps
# instead of running off the terminal.
cli_print_option() { # cli_print_option <label> <description>
    local label=$1 desc=$2 indent=19 first=1 line
    while IFS= read -r line; do
        if ((first)); then
            printf '  %-16s %s\n' "$label" "$line"
            first=0
        else
            printf '%*s%s\n' "$indent" '' "$line"
        fi
    done < <(cli_fold $((78 - indent)) "$desc")
}

cli_help_overview() {
    local c spec
    printf 'Usage: pve-toolbox [options] [command] [arguments]\n\nCommands:\n'
    for c in "${CLI_COMMANDS[@]}"; do printf '  %-12s %s\n' "$c" "${CLI_SUMMARY[$c]}"; done
    printf '\nOptions:\n'
    for spec in "${CLI_GLOBAL_FLAGS[@]}"; do cli_print_option "${spec//|/, }" "${CLI_GLOBAL_DESC[$spec]}"; done
    cli_print_option "--json, --quiet" "machine-readable output (status, check, doctor); --json also for list and config; see 'pve-toolbox help status'"
    printf "\nRun 'pve-toolbox help <command>' for details.\n"
}

cli_help_command() { # cli_help_command <command>
    local c=$1 f spec line
    printf 'Usage: pve-toolbox %s\n\n%s\n' "${CLI_USAGE[$c]}" "${CLI_SUMMARY[$c]}"
    if [[ -n ${CLI_DESC[$c]:-} ]]; then printf '\n'; cli_fold 78 "${CLI_DESC[$c]}"; fi
    [[ -z ${CLI_ROOT[$c]:-} ]] || printf '\nRequires root.\n'
    printf '\nOptions:\n'
    for f in ${CLI_FLAGS[$c]:-}; do cli_print_option "$f" "${CLI_FLAG_DESC[$f]}"; done
    while IFS= read -r spec; do
        cli_print_option "${spec//|/, }" "${CLI_GLOBAL_DESC[$spec]}"
    done < <(cli_global_specs "$c")
    if [[ -n ${CLI_EXAMPLES[$c]:-} ]]; then
        printf '\nExamples:\n'
        while IFS= read -r line; do printf '  %s\n' "$line"; done <<<"${CLI_EXAMPLES[$c]}"
    fi
}

cli_long_flags() { # cli_long_flags -> every long flag, in table order, once each
    local spec f c
    local -A seen=()
    for spec in "${CLI_GLOBAL_FLAGS[@]}"; do
        f=${spec##*|}
        f=${f%%=*}
        [[ -n ${seen[$f]:-} ]] || { seen[$f]=1; printf '%s\n' "$f"; }
    done
    for c in "${CLI_COMMANDS[@]}"; do
        for f in ${CLI_FLAGS[$c]:-}; do
            [[ -n ${seen[$f]:-} ]] || { seen[$f]=1; printf '%s\n' "$f"; }
        done
    done
}

# The global flags that apply to a command: all of them, less the ones listed
# in CLI_NO_GLOBALS for it. No command (or an unknown one) gets every global.
cli_global_specs() { # cli_global_specs [command] -> one CLI_GLOBAL_FLAGS entry per line
    local c=${1:-} spec skip=""
    [[ -z $c || -z ${CLI_NO_GLOBALS[$c]+x} ]] || skip=" ${CLI_NO_GLOBALS[$c]} "
    for spec in "${CLI_GLOBAL_FLAGS[@]}"; do
        [[ $skip == *" $spec "* ]] || printf '%s\n' "$spec"
    done
}

cli_global_flag_names() { # cli_global_flag_names [command] -> one global flag token per line
    local spec p
    local -a parts
    while IFS= read -r spec; do
        IFS='|' read -ra parts <<<"$spec"
        for p in "${parts[@]}"; do
            if [[ $p == *=* ]]; then printf '%s=\n' "${p%%=*}"; else printf '%s\n' "$p"; fi
        done
    done < <(cli_global_specs "${1:-}")
}

cli_global_flag_help() { # cli_global_flag_help [command] -> "flag:description" lines, one per flag token
    local spec p
    local -a parts
    while IFS= read -r spec; do
        IFS='|' read -ra parts <<<"$spec"
        for p in "${parts[@]}"; do
            [[ $p != *=* ]] || p=${p%%=*}=
            printf '%s:%s\n' "$p" "${CLI_GLOBAL_DESC[$spec]}"
        done
    done < <(cli_global_specs "${1:-}")
}

cli_in() { # cli_in <word> <item>... -> true when word is one of the items
    local word=$1 item
    shift
    for item in "$@"; do
        [[ $word != "$item" ]] || return 0
    done
    return 1
}

# Help for one command. A hidden command is known but has no help topic, so
# it is neither documented nor called unknown.
cli_help_topic() { # cli_help_topic <word> -> that command's help, or exits 64
    ! cli_in "$1" "${CLI_HIDDEN[@]}" || cli_usage_error "'$1' is internal and has no help"
    cli_in "$1" "${CLI_COMMANDS[@]}" || cli_unknown_command "$1"
    cli_help_command "$1"
}

cli_unknown_command() { # cli_unknown_command <word> -> exits 64 with suggestions
    local -a s=()
    mapfile -t s < <(cli_suggest "$1" "${CLI_COMMANDS[@]}")
    cli_usage_error "unknown command: $1" "" "${s[@]}"
}

# --------------------------------------------------------------- discovery --

discover() {
    MODULES=()
    local d
    for d in "$MODULE_DIR"/*/; do
        [[ -f "$d/module.sh" ]] || continue
        local name; name=$(basename "$d")
        [[ $name == _* ]] && continue
        MODULES+=("$name")
    done
    if [[ ${#MODULES[@]} -eq 0 ]]; then
        die "no modules found in $MODULE_DIR"
    fi
}

# Read metadata without polluting the current shell.
meta() { # meta <module> <VAR>
    (
        set +u
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$1/module.sh"
        printf '%s' "${!2}"
    )
}

# Run a module function in a subshell so module globals stay isolated.
run_module() { # run_module <module> <function> [args...]
    local mod=$1 fn=$2; shift 2
    [[ -f "$MODULE_DIR/$mod/module.sh" ]] || cli_unknown_module "$mod"
    (
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$mod/module.sh"
        if ! declare -F "$fn" >/dev/null; then
            if [[ $fn == module_status_long ]] && declare -F module_status >/dev/null; then
                local rc=0
                module_status || rc=$?
                echo
                exit "$rc"
            fi
            die "module $mod does not implement $fn"
        fi
        "$fn" "$@"
    )
}

module_has_function() { # module_has_function <module> <function>
    local mod=$1 fn=$2
    [[ -f "$MODULE_DIR/$mod/module.sh" ]] || return 1
    (
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$mod/module.sh"
        declare -F "$fn" >/dev/null
    )
}

# One process-lifetime cache of every module's status line, filled once per
# command, serially, by load_statuses, and used only where the same module
# is asked about more than once in a command: _complete installed, and the
# no-module-names form of update/check/status, which each check
# is_installed on every module and then act on the installed ones. list
# never loads it: it prints one module at a time and a tag filter is applied
# before status is computed, so caching every module up front would compute
# status for modules list is about to discard. Never invalidated and never
# refreshed mid-process: each launcher run reads a consistent snapshot. The
# menu and the ui never load it either, so they keep re-reading status live,
# one module at a time.
declare -gA MODULE_STATUS=()
MODULE_STATUS_LOADED=0

# Fill MODULE_STATUS for every discovered module, one module_status call at a
# time. Idempotent: a second call is a no-op.
load_statuses() {
    [[ $MODULE_STATUS_LOADED -eq 1 ]] && return 0
    discover
    local m st
    for m in "${MODULES[@]}"; do
        st=$(run_module "$m" module_status 2>/dev/null) || true
        MODULE_STATUS[$m]=${st:-not installed}
    done
    MODULE_STATUS_LOADED=1
}

status_line() { # status_line <module> -> short status, "not installed" if it is not
    if [[ $MODULE_STATUS_LOADED -eq 1 && -n ${MODULE_STATUS[$1]+x} ]]; then
        printf '%s' "${MODULE_STATUS[$1]}"
        return 0
    fi
    local st
    st=$(run_module "$1" module_status 2>/dev/null) || true
    printf '%s' "${st:-not installed}"
}

# The one reading of "installed", for the menu, the ui, completion and the
# command line. module_status is contracted to exit 1 when a module is not
# installed, and a module that prints nothing at all is not installed either.
is_installed() { # is_installed <module>
    [[ $(status_line "$1") != "not installed" ]]
}

# ------------------------------------------------------------------- menu --

print_table() {
    local i=1 m title desc st
    printf '\n%s  #  %-24s %-11s %s%s\n' "$c_bold" "MODULE" "STATUS" "DESCRIPTION" "$c_reset"
    for m in "${MODULES[@]}"; do
        title=$(meta "$m" MODULE_TITLE)
        desc=$(meta "$m" MODULE_DESC)
        st=$(status_line "$m")
        local mark="   "
        [[ " ${SELECTED[*]:-} " == *" $m "* ]] && mark=" ${c_green}*${c_reset} "
        if [[ $st == "not installed" ]]; then
            printf '%s%2d) %-24s %s%-11s%s %s\n' "$mark" "$i" "$title" "$c_dim" "-" "$c_reset" "$desc"
        else
            printf '%s%2d) %-24s %s%-11s%s %s\n' "$mark" "$i" "$title" "$c_green" "${st%% *}" "$c_reset" "$desc"
        fi
        i=$((i + 1))
    done
    echo
}

menu() {
    discover
    SELECTED=()
    while true; do
        printf '\n%s pve-toolbox %s%s\n' "$c_bold$c_blue" "$(hostname -s)" "$c_reset"
        print_table
        dim "  numbers toggle selection (e.g. '1 3'), then:"
        printf '  %si%s install/reconfigure selected   %su%s update all installed\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sc%s check for updates              %ss%s status of selected\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sx%s uninstall selected             %sq%s quit\n\n' \
            "$c_bold" "$c_reset" "$c_bold" "$c_reset"
        printf '  %sl%s update LXC container packages\n' "$c_bold" "$c_reset"
        printf '  %sa%s configure automatic LXC updates\n\n' "$c_bold" "$c_reset"

        local reply
        read -r -p "> " reply || { echo; return 0; }
        [[ -z $reply ]] && continue

        case ${reply,,} in
            q|quit|exit) return 0 ;;
            l|lxc-update) cmd_lxc_update || warn "LXC update did not complete" ;;
            a|lxc-schedule)
                step "Configure automatic LXC updates"
                run_module lxc-update module_status_long || true
                echo
                run_module lxc-update module_install \
                    || warn "LXC automatic-update configuration did not complete" ;;
            i|install)
                [[ ${#SELECTED[@]} -eq 0 ]] && { warn "nothing selected"; continue; }
                local m; for m in "${SELECTED[@]}"; do
                    step "Installing $(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_install || warn "$m did not complete"
                done
                SELECTED=() ;;
            u|update)
                local m; for m in "${MODULES[@]}"; do
                    is_installed "$m" || continue
                    step "Updating $(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_update || warn "$m update failed"
                done ;;
            c|check)
                local m; for m in "${MODULES[@]}"; do
                    is_installed "$m" || continue
                    step "$(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_update --check || true
                done ;;
            s|status)
                local list=() m
                if [[ ${#SELECTED[@]} -gt 0 ]]; then list=("${SELECTED[@]}"); else list=("${MODULES[@]}"); fi
                for m in "${list[@]}"; do
                    step "$(meta "$m" MODULE_TITLE)"
                    run_module "$m" module_status_long || true
                done ;;
            x|uninstall)
                [[ ${#SELECTED[@]} -eq 0 ]] && { warn "nothing selected"; continue; }
                warn "about to uninstall: ${SELECTED[*]}"
                if confirm "are you sure?" "n"; then
                    local m; for m in "${SELECTED[@]}"; do
                        step "Removing $(meta "$m" MODULE_TITLE)"
                        run_module "$m" module_uninstall || warn "$m removal failed"
                    done
                    SELECTED=()
                fi ;;
            *)
                local tok idx m
                for tok in $reply; do
                    [[ $tok =~ ^[0-9]+$ ]] || { warn "not a number: $tok"; continue; }
                    idx=$((tok - 1))
                    [[ $idx -lt 0 || $idx -ge ${#MODULES[@]} ]] && { warn "out of range: $tok"; continue; }
                    m=${MODULES[$idx]}
                    if [[ " ${SELECTED[*]:-} " == *" $m "* ]]; then
                        local keep=() k
                        for k in "${SELECTED[@]}"; do [[ $k != "$m" ]] && keep+=("$k"); done
                        SELECTED=("${keep[@]:-}")
                        [[ -z ${SELECTED[0]:-} ]] && SELECTED=()
                    else
                        SELECTED+=("$m")
                    fi
                done ;;
        esac
    done
}

# --------------------------------------------------------------- commands --

cmd_lxc_update() {
    bash "$MODULE_DIR/lxc-update/run.sh" "$@"
}

# module_tags_of <module> -> fills the caller's local 'tags' array with
# <module>'s tags, split on any run of whitespace, first line of MODULE_TAGS
# only (bash's own 'read -a' record/field splitting). The one definition of
# what a module's tags are: module_has_tag, module_tags, and list --json's
# tags array all go through it, so they can never disagree.
module_tags_of() {
    read -r -a tags <<<"$(meta "$1" MODULE_TAGS)"
}

# module_has_tag <module> <tag>: the module carries <tag>.
module_has_tag() {
    local t
    local -a tags
    module_tags_of "$1"
    for t in "${tags[@]}"; do [[ $t != "$2" ]] || return 0; done
    return 1
}

# Every tag any module carries, sorted, once each.
module_tags() {
    local m
    local -a tags
    discover
    for m in "${MODULES[@]}"; do
        module_tags_of "$m"
        if [[ ${#tags[@]} -gt 0 ]]; then
            printf '%s\n' "${tags[@]}"
        fi
    done | sort -u
}

cmd_list() {
    discover
    local tag=${1:-} m t found=0
    local -a known=() s=()
    if [[ -n $tag ]]; then
        mapfile -t known < <(module_tags)
        for t in "${known[@]}"; do [[ $t != "$tag" ]] || found=1; done
        if [[ $found -eq 0 ]]; then
            mapfile -t s < <(cli_suggest "$tag" "${known[@]}")
            cli_usage_error "unknown tag: $tag" list "${s[@]}"
        fi
    fi
    # Neither branch below loads the MODULE_STATUS cache: each shown module's
    # status is computed once, right where it is printed. A tag filter is
    # applied first (the 'continue'), so a module the filter discards never
    # has its module_status run at all, and plain 'list' still streams a
    # module at a time instead of waiting on every module up front.
    if [[ $OUTPUT_JSON -eq 1 ]]; then
        local json='[]' item st
        local -a tags
        for m in "${MODULES[@]}"; do
            [[ -n $tag ]] && ! module_has_tag "$m" "$tag" && continue
            st=$(status_line "$m")
            module_tags_of "$m"
            item=$(jq -cn --arg name "$m" \
                --arg title "$(report_clean_text "$(meta "$m" MODULE_TITLE)")" \
                --arg description "$(report_clean_text "$(meta "$m" MODULE_DESC)")" \
                --arg raw "$st" \
                --arg status "$(report_clean_text "$st")" \
                --args '{name:$name,title:$title,description:$description,
                  tags:$ARGS.positional,
                  installed:($raw != "not installed"),status:$status}' \
                "${tags[@]}")
            json=$(jq -cn --argjson a "$json" --argjson i "$item" '$a + [$i]')
        done
        jq -n --argjson modules "$json" '{schema_version:1,command:"list",modules:$modules}'
        return 0
    fi
    for m in "${MODULES[@]}"; do
        [[ -n $tag ]] && ! module_has_tag "$m" "$tag" && continue
        printf '%s%-24s%s %s\n' "$c_bold" "$m" "$c_reset" "$(meta "$m" MODULE_DESC)"
        printf '  %sstatus: %s | tags: %s%s\n' \
            "$c_dim" "$(status_line "$m")" "$(meta "$m" MODULE_TAGS)" "$c_reset"
    done
}

cmd_each() { # cmd_each <function> [--check] <modules...>
    local fn=$1; shift
    local extra=""
    local failed=0 TOOLBOX_UPDATE_EXPLICIT=0
    [[ ${1:-} == --check ]] && { extra=--check; shift; }
    discover
    local list=("$@") m
    [[ $fn != module_update || ${#list[@]} == 0 ]] || TOOLBOX_UPDATE_EXPLICIT=1
    if [[ ${#list[@]} -eq 0 ]]; then
        load_statuses
        for m in "${MODULES[@]}"; do
            is_installed "$m" || continue
            list+=("$m")
        done
    fi
    [[ ${#list[@]} -eq 0 ]] && { warn "no installed modules"; return 0; }
    for m in "${list[@]}"; do
        [[ -f "$MODULE_DIR/$m/module.sh" ]] || cli_unknown_module "$m"
    done
    for m in "${list[@]}"; do
        step "$(meta "$m" MODULE_TITLE)"
        if [[ $fn == module_status_long ]]; then
            # module_status exits 1 to mean "not installed", which is the
            # answer status was asked for. Naming a module that is not
            # installed is a legitimate thing to do; it is not a failure.
            run_module "$m" "$fn" || true
        elif [[ -n $extra ]]; then
            if ! run_module "$m" "$fn" "$extra"; then
                warn "$m failed"
                failed=1
            fi
        else
            if ! run_module "$m" "$fn"; then
                warn "$m failed"
                failed=1
            fi
        fi
    done
    return "$failed"
}

cmd_module_report() { # cmd_module_report <status|check> <function> [--check] <modules...>
    local command=$1 fn=$2; shift 2
    local extra="" explicit=1
    [[ ${1:-} == --check ]] && { extra=--check; shift; }
    local list=("$@") m output rc state summary
    [[ ${#list[@]} -eq 0 ]] && explicit=0

    report_reset "$command"
    discover
    if [[ $explicit -eq 0 ]]; then
        load_statuses
        for m in "${MODULES[@]}"; do
            is_installed "$m" || continue
            list+=("$m")
        done
    fi
    for m in "${list[@]}"; do
        [[ -f "$MODULE_DIR/$m/module.sh" ]] || cli_unknown_module "$m"
        if [[ $command == status ]] && ! is_installed "$m"; then
            report_add skipped "module.$m.status" "module is not installed"
            continue
        fi

        output=""; rc=0
        if [[ -n $extra ]]; then
            output=$(run_module "$m" "$fn" "$extra" 2>&1) || rc=$?
        else
            output=$(run_module "$m" "$fn" 2>&1) || rc=$?
        fi
        if [[ $rc -ne 0 ]]; then
            report_add fail "module.$m.$command" "$command failed with exit $rc" "$output"
            continue
        fi

        state=pass
        summary="$command completed"
        if [[ $command == check && $output == *"update available:"* ]]; then
            state=warn
            summary="update available"
        elif [[ $command == check && $output == *" is older than "* ]]; then
            state=warn
            summary="configured release is older than the installed version"
        fi
        report_add "$state" "module.$m.$command" "$summary" "$output"
    done

    local exit_code
    exit_code=$(report_exit_code)
    if [[ $OUTPUT_QUIET -eq 0 ]]; then
        report_render_json "$exit_code"
    fi
    return "$exit_code"
}

cmd_doctor() {
    doctor_reset
    doctor_run_core

    discover
    local m status output rc
    for m in "${MODULES[@]}"; do
        status=""; rc=0
        output=$(run_module "$m" module_status 2>/dev/null) || rc=$?
        status=${output:-not installed}
        [[ $status == "not installed" ]] && continue
        if [[ $rc -ne 0 ]]; then
            doctor_result fail "module.$m.status" \
                "installed module status failed with exit $rc"
            continue
        fi
        doctor_result pass "module.$m.status" "installed: $status"

        module_has_function "$m" module_doctor || continue
        output=""; rc=0
        output=$(DOCTOR_EMIT=1 DOCTOR_PREFIX="module.$m." \
            run_module "$m" module_doctor 2>&1) || rc=$?
        doctor_import_module "$m" "$rc" "$output"
    done

    local exit_code
    exit_code=$(report_exit_code)
    if [[ $OUTPUT_QUIET -eq 1 ]]; then
        return "$exit_code"
    fi
    if [[ $OUTPUT_JSON -eq 1 ]]; then
        report_render_json "$exit_code"
        return "$exit_code"
    fi
    doctor_render
}

# ---------------------------------------------------------- config show --
#
# Displays a module's saved configuration. Those files hold webhook URLs,
# tokens and credentials, so a value is shown only for a key the module
# declares public in MODULE_CONFIG_PUBLIC; every other key shows only
# whether it is set. Files are parsed, never run (see _config_parse), and
# module_config_files reads them through the same parser.
# Nothing is read until the directory and every file to be shown have
# passed _config_check_path, and nothing is printed until every file has
# been parsed, so a refusal never follows partial output.

# A configuration name: the <name> of TOOLBOX_CONF_DIR/<name>.conf, for a
# module or for an extra file its module_config_files lists. No '/', and no
# leading '.' or '-'.
CONFIG_NAME_RE='^[a-z0-9][a-z0-9-]*$'

# Refuses a path another user could have planted or swapped: a symbolic
# link, the wrong type, not owned by root, or writable by group or others.
# The message names the path and the reason, never anything read from it.
_config_check_path() { # _config_check_path <file|directory> <path>
    local kind=$1 path=$2 what info owner mode
    what="configuration $kind $path"
    [[ ! -L $path ]] || die "refusing $what: it is a symbolic link"
    if [[ $kind == directory ]]; then
        [[ -d $path ]] || die "refusing $what: not a directory"
    else
        [[ -f $path ]] || die "refusing $what: not a regular file"
    fi
    info=$(stat -c '%u %a' -- "$path") || die "refusing $what: cannot read its owner and mode"
    read -r owner mode <<<"$info"
    [[ $owner == 0 ]] || die "refusing $what: not owned by root"
    [[ $mode =~ ^[0-7]+$ ]] || die "refusing $what: cannot read its mode"
    (((8#$mode & 8#022) == 0)) || die "refusing $what: writable by group or others"
}

# Parses one checked configuration file into CONFIG_ORDER (its keys, in
# first-appearance order) and CONFIG_VALUES (key -> value), or dies.
#
# The file is parsed, never run: config show accepts exactly the format
# conf_set writes, the only one the toolbox has ever written. That is blank
# lines, lines starting with '#', and KEY='value' lines, where a value is
# single-quoted segments joined by \' (conf_set writes a quote inside a
# value as '\'') and a segment may span lines. The last assignment of a key
# wins, as it would for the shell. Anything else refuses the file with the
# line number and the reason, never the line itself. Values are therefore
# exactly what was stored: nothing is expanded, and nothing in the file can
# run. One pass over the lines, each looked at once.
CONFIG_ORDER=()
declare -A CONFIG_VALUES=()
_config_parse() { # _config_parse <file>
    local LC_ALL=C
    local file=$1 content="" size n start key value text state
    local re_assign='^([A-Za-z_][A-Za-z0-9_]*)=(.*)$'
    local re_close="^([^']*)'(.*)$"
    local -a lines=()
    CONFIG_ORDER=()
    CONFIG_VALUES=()
    # Byte-wise from here on. read stops at a NUL byte, which a text file
    # never holds, so a short read against the size refuses the file.
    size=$(stat -c '%s' -- "$file") || die "could not read configuration file $file"
    IFS= read -r -d '' content <"$file" || true
    [[ ${#content} -eq $size ]] || die "refusing configuration file $file: it contains a NUL byte"
    [[ -z $content ]] || mapfile -t lines <<<"${content%$'\n'}"
    # state: out (between entries), in (inside a quoted segment, which may
    # continue on the next line), after (just past a closing quote).
    state=out
    for ((n = 0; n < ${#lines[@]}; n++)); do
        text=${lines[n]}
        if [[ $state == in ]]; then
            value+=$'\n'
        elif [[ -z $text || $text == '#'* ]]; then
            continue
        elif [[ $text =~ $re_assign ]]; then
            start=$n
            key=${BASH_REMATCH[1]}
            text=${BASH_REMATCH[2]}
            value=""
            [[ $text == "'"* ]] || _config_refuse "$file" "$start" "the value is not single-quoted"
            text=${text:1}
            state=in
        else
            _config_refuse "$file" "$n" "not a comment or a KEY='value' line"
        fi
        while :; do
            if [[ $state == in ]]; then
                if [[ $text =~ $re_close ]]; then
                    value+=${BASH_REMATCH[1]}
                    text=${BASH_REMATCH[2]}
                    state=after
                else
                    value+=$text
                    break
                fi
            elif [[ -z $text ]]; then
                [[ -n ${CONFIG_VALUES[$key]+x} ]] || CONFIG_ORDER+=("$key")
                CONFIG_VALUES[$key]=$value
                state=out
                break
            elif [[ $text == "\\''"* ]]; then
                value+="'"
                text=${text:3}
                state=in
            else
                _config_refuse "$file" "$start" "unexpected text after the value"
            fi
        done
    done
    [[ $state == out ]] || _config_refuse "$file" "$start" "unterminated single quote"
}

# Refuses a file that is not in the conf_set format, naming the line where
# the entry that failed starts. Never the line itself: it may hold a value.
_config_refuse() { # _config_refuse <file> <0-based line> <reason>
    die "refusing configuration file $1: line $(($2 + 1)): $3"
}

# Reads one checked configuration file into CONFIG_RECORDS: four fields per
# key, in first-appearance order and once each: the key, 1 or 0 for set
# (non-empty), 1 or 0 for public, and the value, which is empty unless the
# key is public.
CONFIG_RECORDS=()
_config_read() { # _config_read <file> <public pattern>...
    local file=$1 key value set
    shift
    _config_parse "$file"
    CONFIG_RECORDS=()
    for key in "${CONFIG_ORDER[@]}"; do
        value=${CONFIG_VALUES[$key]}
        set=0
        [[ -z $value ]] || set=1
        if _config_public "$key" "$@"; then
            CONFIG_RECORDS+=("$key" "$set" 1 "$value")
        else
            CONFIG_RECORDS+=("$key" "$set" 0 "")
        fi
    done
    CONFIG_VALUES=()
}

# conf_get as config show gives it to module_config_files: the same checks
# and parser, so the file is never run. Prints the stored value of <key>, or
# nothing when the file or the key is absent. A refusal is written to fd 3,
# which config show reads, and the call fails; the module's own stderr is
# discarded, so the reason reaches the operator only through config show.
_config_safe_get() { # _config_safe_get <name> <key>
    (
        die() { printf 'refuse:%s\n' "$*" >&3; exit 1; }
        local f
        [[ $1 =~ $CONFIG_NAME_RE ]] || die "module_config_files read an invalid configuration name"
        f=$(conf_file "$1")
        [[ -e $f || -L $f ]] || exit 0
        _config_check_path file "$f"
        _config_parse "$f"
        [[ -z ${2:-} ]] || printf '%s' "${CONFIG_VALUES[$2]-}"
    )
}

# Runs <module>'s module_config_files with conf_get replaced by
# _config_safe_get and conf_load refused, both readonly so nothing the module
# sources later can put the originals back. Its stdout carries the names and
# any refusal lines; its stderr is discarded.
_config_module_files() { # _config_module_files <module>
    (
        # shellcheck source=/dev/null
        source "$MODULE_DIR/$1/module.sh"
        conf_get() { _config_safe_get "$@"; }
        conf_load() {
            printf 'refuse:%s\n' "module_config_files may read configuration only with conf_get, not conf_load" >&3
            return 1
        }
        readonly -f conf_get conf_load
        module_config_files
    ) 3>&1 2>/dev/null
}

# True when <key> matches one of the module's public patterns.
_config_public() { # _config_public <key> <pattern>...
    local key=$1 p
    shift
    for p in "$@"; do
        # Intentional glob match: MODULE_CONFIG_PUBLIC may hold patterns.
        # shellcheck disable=SC2053
        [[ $key != $p ]] || return 0
    done
    return 1
}

cmd_config() { # cmd_config show <module>
    local sub=${1:-} mod=${2:-} name out f i key value display line text="" rc
    local -a s=() names=() files=() patterns=() stream=()
    case $sub in
        show) ;;
        "")   cli_usage_error "config needs a subcommand: show" config ;;
        *)    mapfile -t s < <(cli_suggest "$sub" show)
              cli_usage_error "unknown config subcommand: $sub" config "${s[@]}" ;;
    esac
    [[ -n $mod ]] || cli_usage_error "config show needs a module name" config
    (($# <= 2)) || cli_usage_error "config show takes one module name" config
    discover
    cli_in "$mod" "${MODULES[@]}" || cli_unknown_module "$mod"
    [[ $EUID -eq 0 ]] || die "config show needs root: configuration files are readable by root only"
    [[ $mod =~ $CONFIG_NAME_RE ]] \
        || die "refusing configuration name $(printf '%q' "$mod"): it must match $CONFIG_NAME_RE"
    read -r -a patterns <<<"$(meta "$mod" MODULE_CONFIG_PUBLIC)"

    # A trailing '/' or '/.' makes -L test the link's target instead of the
    # link, so the directory is normalised first, without resolving any
    # symbolic link, and used in that form for every check and every read.
    TOOLBOX_CONF_DIR=$(realpath -sm -- "$TOOLBOX_CONF_DIR") \
        || die "cannot normalise the configuration directory path"

    # Every check passes before any file is read, module_config_files
    # included: it may read the module's own file to find the others.
    names=("$mod")
    if [[ -e $TOOLBOX_CONF_DIR || -L $TOOLBOX_CONF_DIR ]]; then
        _config_check_path directory "$TOOLBOX_CONF_DIR"
        f=$(conf_file "$mod")
        if [[ -e $f || -L $f ]]; then _config_check_path file "$f"; fi
        if module_has_function "$mod" module_config_files; then
            rc=0
            out=$(_config_module_files "$mod") || rc=$?
            # A refusal from the replaced conf_get wins over anything else.
            while IFS= read -r name; do
                [[ $name != refuse:* ]] || die "${name#refuse:} (read by module $mod)"
            done <<<"$out"
            [[ $rc -eq 0 ]] || die "module $mod failed to list its configuration files"
            while IFS= read -r name; do
                [[ -n $name ]] || continue
                # Not echoed: a name built from configuration could carry a value.
                [[ $name =~ $CONFIG_NAME_RE ]] \
                    || die "module $mod listed an invalid configuration name (each must match $CONFIG_NAME_RE)"
                cli_in "$name" "${names[@]}" || names+=("$name")
            done <<<"$out"
        fi
        for name in "${names[@]}"; do
            f=$(conf_file "$name")
            [[ -e $f || -L $f ]] || continue
            _config_check_path file "$f"
            files+=("$name")
        done
    fi

    # JSON mode streams every field to one jq on stdin, NUL-separated: per
    # file its name and key count, then key, set, public and value per key.
    # Nothing passes through argv, so no value is limited by ARG_MAX.
    for name in "${files[@]}"; do
        f=$(conf_file "$name")
        _config_read "$f" "${patterns[@]}"
        if [[ $OUTPUT_JSON -eq 1 ]]; then
            stream+=("$name" "$((${#CONFIG_RECORDS[@]} / 4))")
        else
            [[ -z $text ]] || text+=$'\n'
            text+="$c_bold$name$c_reset $c_dim($f)$c_reset"$'\n'
            [[ ${#CONFIG_RECORDS[@]} -gt 0 ]] || text+=$'  (no keys)\n'
        fi
        for ((i = 0; i < ${#CONFIG_RECORDS[@]}; i += 4)); do
            key=${CONFIG_RECORDS[i]}
            if [[ ${CONFIG_RECORDS[i + 2]} == 1 ]]; then
                value=$(report_clean_text "${CONFIG_RECORDS[i + 3]}")
                # Cleaned text can still hold escape sequences; a terminal
                # gets none of them.
                display=${value//[[:cntrl:]]/?}
                [[ ${CONFIG_RECORDS[i + 1]} == 1 ]] || display="(not set)"
            else
                value=""
                display="(not set)"
                [[ ${CONFIG_RECORDS[i + 1]} != 1 ]] || display="(set, hidden)"
            fi
            if [[ $OUTPUT_JSON -eq 1 ]]; then
                stream+=("$key" "${CONFIG_RECORDS[i + 1]}" "${CONFIG_RECORDS[i + 2]}" "$value")
            else
                printf -v line '  %-28s %s\n' "$key" "$display"
                text+=$line
            fi
        done
    done

    if [[ $OUTPUT_JSON -eq 1 ]]; then
        { if ((${#stream[@]})); then printf '%s\0' "${stream[@]}"; fi; } | jq -Rs --arg m "$mod" '
            def files($t; $i):
                if $i >= ($t | length) then []
                else ($t[$i + 1] | tonumber) as $n
                    | [{name: $t[$i],
                        keys: [range(0; $n) as $k | $t[$i + 2 + 4 * $k : $i + 6 + 4 * $k]
                               | {key: .[0], set: (.[1] == "1"), hidden: (.[2] != "1")}
                                 + (if .[2] == "1" then {value: .[3]} else {} end)]}]
                      + files($t; $i + 2 + 4 * $n)
                end;
            (split("\u0000") | .[:-1]) as $t
            | {schema_version: 1, command: "config", module: $m, files: files($t; 0)}'
    elif [[ ${#files[@]} -eq 0 ]]; then
        printf 'no saved configuration for %s\n' "$mod"
    else
        printf '%s' "$text"
    fi
}

# ------------------------------------------------------------------- ui --

# Modules prompt and print while they work, which cannot happen inside a
# whiptail box, so the widgets only ever choose. Once something is chosen the
# screen is handed back and the module runs exactly as it does from the
# command line.

# Answers through UI_PICKED instead of stdout, so only the checklist is ever
# inside a $( ). A widget called in a capture draws into the pipe rather than
# onto the screen, and the box is then invisible but still waiting.
UI_PICKED=""

ui_pick() { # ui_pick <title> <all|installed> <on|off> -> sets UI_PICKED
    local title=$1 pool=$2 default=$3
    local -a items=()
    local m st selected_default
    UI_PICKED=""

    # One module_status per module, and some of them shell out to zpool.
    tui_info "Reading module status..."
    for m in "${MODULES[@]}"; do
        st=$(status_line "$m")
        [[ $pool == installed && $st == "not installed" ]] && continue
        selected_default=$default
        if [[ $title == Update && $(meta "$m" MODULE_EXPLICIT_UPDATE) == 1 ]]; then selected_default=off; fi
        items+=("$m" "$(meta "$m" MODULE_TITLE) - $st" "$selected_default")
    done

    if [[ ${#items[@]} -eq 0 ]]; then
        tui_msg "$title" "No modules are installed."
        return 1
    fi
    UI_PICKED=$(tui_checklist "$title" \
        "Space toggles, Enter confirms, Esc goes back." "${items[@]}")
}

ui_run() { # ui_run <fn> <modules> [extra-arg]
    local fn=$1 picked=$2 extra=${3:-} m
    # shellcheck disable=SC2034 # Module hook reads the scoped dispatch context.
    local TOOLBOX_UPDATE_EXPLICIT=1
    local -a mods=()

    # Collect the whole list before running anything. `done <<<` redirects
    # stdin for the entire loop body, so a module's ask/ask_secret/confirm
    # would read the remains of this list rather than the terminal: its first
    # prompt would take a module name as its answer, and once the list ran
    # out every prompt would fail as closed input and end the install.
    while IFS= read -r m; do
        [[ -n $m ]] && mods+=("$m")
    done <<<"$picked"

    tui_clear
    for m in "${mods[@]}"; do
        step "$(meta "$m" MODULE_TITLE)"
        if [[ $fn == module_status_long ]]; then
            # module_status exits 1 to mean "not installed". That is what the
            # status action is there to report, not a failure to announce.
            run_module "$m" "$fn" || true
        elif [[ -n $extra ]]; then
            run_module "$m" "$fn" "$extra" || warn "$m failed"
        else
            run_module "$m" "$fn" || warn "$m failed"
        fi
    done
    echo
    read -rsn1 -p "press any key to go back to the menu " _ || true
    echo
}

ui_action() { # ui_action <title> <fn> <pool> <default> [extra-arg]
    local title=$1 fn=$2 pool=$3 default=$4 extra=${5:-}
    ui_pick "$title" "$pool" "$default" || return 0
    [[ -z $UI_PICKED ]] && return 0
    if [[ $fn == module_uninstall ]]; then
        tui_yesno "Uninstall" \
            "About to remove:"$'\n\n'"$UI_PICKED"$'\n\n'"Continue?" || return 0
    fi
    ui_run "$fn" "$UI_PICKED" "$extra"
}

cmd_ui() {
    [[ -t 0 && -t 1 ]] || die "ui needs a terminal, try 'pve-toolbox list'"
    # whiptail exits 1 on a terminal it cannot draw on, which is also its exit
    # code for Cancel. There is no telling the two apart once a widget has run,
    # and the ui would look like it quit the instant it started, so rule the
    # case out up front.
    case ${TERM:-} in
        ""|dumb|unknown) die "ui needs a capable terminal, TERM is '${TERM:-unset}'" ;;
    esac
    # shellcheck source=lib/tui.sh
    source "$TOOLBOX_ROOT/lib/tui.sh"
    tui_detect || die "ui needs whiptail or dialog (apt install whiptail)"
    discover
    local host
    host=$(hostname -s 2>/dev/null) || host=""
    TUI_BACKTITLE="pve-toolbox${host:+ @ $host}"

    local choice
    while true; do
        choice=$(tui_menu "pve-toolbox" "Arrows move, Enter chooses, Esc quits." \
            install   "Install or reconfigure modules" \
            update    "Update installed modules" \
            check     "Check for updates, change nothing" \
            status    "Show detailed status" \
            uninstall "Remove installed modules" \
            lxc-update "Update LXC container packages" \
            lxc-schedule "Configure automatic LXC updates" \
            quit      "Exit") || { tui_clear; return 0; }
        case $choice in
            install)   ui_action "Install / reconfigure" module_install     all       off ;;
            update)    ui_action "Update"                module_update      installed on  ;;
            check)     ui_action "Check for updates"     module_update      installed on --check ;;
            status)    ui_action "Status"                module_status_long all       on  ;;
            uninstall) ui_action "Uninstall"             module_uninstall   installed off ;;
            lxc-update) ui_lxc_update ;;
            lxc-schedule) ui_lxc_schedule ;;
            quit)      tui_clear; return 0 ;;
        esac
    done
}

ui_lxc_update() {
    local picked option ids="" rc=0
    local -a flags=() targets=()
    picked=$(tui_checklist "LXC package updates" "Choose options. Execution asks for confirmation." \
        dry-run "Preview only (cached package indexes)" on \
        allow-removals "Allow package removals and cleanup" off \
        notify "Send Discord report" off) || return 0
    while IFS= read -r option; do
        [[ -z $option ]] || flags+=("--$option")
    done <<<"$picked"
    tui_clear
    ask ids "Container IDs, space-separated; all eligible when blank" ""
    read -r -a targets <<<"$ids"
    cmd_lxc_update "${flags[@]}" "${targets[@]}" || rc=$?
    [[ $rc == 0 ]] || warn "LXC update returned $rc; inspect the results above"
    read -rsn1 -p "press any key to go back to the menu " _ || true
}

ui_lxc_schedule() {
    tui_clear
    step "Configure automatic LXC updates"
    run_module lxc-update module_status_long || true
    echo
    run_module lxc-update module_install \
        || warn "LXC automatic-update configuration did not complete"
    echo
    read -rsn1 -p "press any key to go back to the menu " _ || true
    echo
}

cmd_link() {
    [[ $TOOLBOX_PACKAGED -eq 0 ]] \
        || die "this install is managed by apt; do not replace dpkg-owned paths"
    require_root
    ln -sfn "$TOOLBOX_ROOT/pve-toolbox" "$TOOLBOX_BIN_DIR/pve-toolbox"
    ok "linked $TOOLBOX_BIN_DIR/pve-toolbox -> $TOOLBOX_ROOT/pve-toolbox"
    link_completions
}

# Symlinked, not copied, so self-update refreshes them with the rest of the
# checkout. Only into directories the shell already scans: creating one would
# mean guessing at a shell that is not installed.
link_completions() {
    local pair dest src
    for pair in \
        "$TOOLBOX_BASH_COMPLETION_DIR/pve-toolbox:completions/pve-toolbox.bash" \
        "$TOOLBOX_ZSH_COMPLETION_DIR/_pve-toolbox:completions/_pve-toolbox"
    do
        dest=${pair%%:*}; src="$TOOLBOX_ROOT/${pair#*:}"
        if [[ ! -d ${dest%/*} ]]; then
            dim "  skipped ${dest%/*}, not present"
            continue
        fi
        ln -sfn "$src" "$dest"
        ok "linked $dest"
    done
    dim "  completions load in new shells"
}

# Candidates for the completion scripts. Separate from `list` because that
# prints a status per module, and a TAB press should not shell out to zpool.
cmd_complete() { # cmd_complete <commands|modules|installed|tags|flags <cmd>|flag-help <cmd>>
    local m f cmd
    case ${1:-} in
        commands)
            printf '%s\n' "${CLI_COMMANDS[@]}" ;;
        modules)
            discover; printf '%s\n' "${MODULES[@]}" ;;
        installed)
            load_statuses
            # An if, not an &&: with nothing installed the last iteration
            # would otherwise decide the exit status.
            for m in "${MODULES[@]}"; do
                if is_installed "$m"; then printf '%s\n' "$m"; fi
            done ;;
        tags)
            module_tags ;;
        flags)
            cmd=${2:-}
            cli_global_flag_names "$cmd"
            # An empty subscript is a bad-array-subscript error under set -u,
            # not merely an unset one, so an absent or empty command has to be
            # ruled out before indexing at all; this is the completion a TAB
            # press makes before any command has been typed. An unknown
            # command is likewise not in CLI_FLAGS, so it falls through to
            # the globals alone, same as no command.
            if [[ -n $cmd && -n ${CLI_FLAGS[$cmd]+x} ]]; then
                # shellcheck disable=SC2086 # CLI_FLAGS values are space-separated lists.
                printf '%s\n' ${CLI_FLAGS[$cmd]}
            fi ;;
        flag-help)
            cmd=${2:-}
            cli_global_flag_help "$cmd"
            if [[ -n $cmd && -n ${CLI_FLAGS[$cmd]+x} ]]; then
                # shellcheck disable=SC2086 # CLI_FLAGS values are space-separated lists.
                for f in ${CLI_FLAGS[$cmd]}; do
                    printf '%s:%s\n' "$f" "${CLI_FLAG_DESC[$f]}"
                done
            fi ;;
        *)  usage_error "unknown completion target: ${1:-}" ;;
    esac
}

cmd_self_update() {
    [[ $TOOLBOX_PACKAGED -eq 0 ]] \
        || die "this install is managed by apt; run: apt update && apt upgrade pve-toolbox"
    [[ -d "$TOOLBOX_ROOT/.git" ]] || die "$TOOLBOX_ROOT is not a git checkout"
    command -v git >/dev/null 2>&1 || die "git not installed"
    info "pulling $TOOLBOX_ROOT"
    git -C "$TOOLBOX_ROOT" pull --ff-only
    ok "now at $(git -C "$TOOLBOX_ROOT" describe --always --dirty)"
}

# ------------------------------------------------------------------- _man --
#
# The man page is generated from the same command table 'help' reads, so a
# command documented once cannot drift out of sync with its man page entry.
# Runs at package build time (see share/man/pve-toolbox.1.in); never touches
# modules, so it needs neither discovery nor root.

# roff reads a leading '\' or '-' specially, so both are escaped in any text
# taken from the command table.
_man_escape() { local v=$1; v=${v//\\/\\\\}; v=${v//-/\\-}; printf '%s' "$v"; }

# A roff line beginning with '.' reads as a request, and one beginning with
# an apostrophe as a control line; a leading '\&' (a zero-width character)
# defuses either without changing what is printed.
_man_text() { # _man_text <raw> -> escaped, safe as a standalone roff line
    local v; v=$(_man_escape "$1")
    case $v in
        .*|\'*) printf '\\&%s' "$v" ;;
        *)      printf '%s' "$v" ;;
    esac
}

# _man_join_and <item>... -> "a", "a and b", or "a, b and c"
_man_join_and() {
    local -a items=("$@")
    local n=${#items[@]} head
    case $n in
        0) return 0 ;;
        1) printf '%s' "${items[0]}" ;;
        *) head=$(printf '%s, ' "${items[@]:0:n-1}")
           printf '%s and %s' "${head%, }" "${items[n - 1]}" ;;
    esac
}

# The global options a command's own runner refuses, as a sentence, e.g.
# "The -y, --yes and -f, --force options are refused." Empty when the
# command refuses none.
_man_no_globals_sentence() { # _man_no_globals_sentence <command>
    local c=$1 spec
    local -a parts=()
    [[ -n ${CLI_NO_GLOBALS[$c]:-} ]] || return 0
    for spec in ${CLI_NO_GLOBALS[$c]}; do
        parts+=("${spec//|/, }")
    done
    printf 'The %s options are refused.' "$(_man_join_and "${parts[@]}")"
}

cmd_man() {
    local template="$TOOLBOX_ROOT/share/man/pve-toolbox.1.in" date c f spec commands options line
    [[ -r $template ]] || die "man page template missing: $template"
    if [[ -n ${SOURCE_DATE_EPOCH:-} ]]; then
        date=$(LC_ALL=C date -u -d "@$SOURCE_DATE_EPOCH" '+%B %Y')
    else
        date=$(LC_ALL=C date -u -r "$template" '+%B %Y')
    fi
    commands=""
    for c in "${CLI_COMMANDS[@]}"; do
        # Capitalised so the man-page summary reads as a sentence opener;
        # 'help' keeps the lowercase, mid-sentence form used in its table.
        commands+=$'.TP\n'".B $(_man_escape "${CLI_USAGE[$c]}")"$'\n'"$(_man_text "${CLI_SUMMARY[$c]^}")."$'\n'
        # Each optional fact below gets its own .sp, matching the blank-line
        # separation cli_help_command uses between the same facts, so two
        # sentences (e.g. a summary and a CLI_DESC that both open the same
        # way) never read as one run-on paragraph.
        if [[ -n ${CLI_DESC[$c]:-} ]]; then
            commands+=$'.sp\n'"$(_man_text "${CLI_DESC[$c]}")"$'\n'
        fi
        if [[ -n ${CLI_ROOT[$c]:-} ]]; then
            commands+=$'.sp\n'"$(_man_text "Requires root.")"$'\n'
        fi
        if [[ -n ${CLI_NO_GLOBALS[$c]:-} ]]; then
            commands+=$'.sp\n'"$(_man_text "$(_man_no_globals_sentence "$c")")"$'\n'
        fi
        for f in ${CLI_FLAGS[$c]:-}; do
            commands+=$'.RS\n.TP\n'".B $(_man_escape "$f")"$'\n'"$(_man_text "${CLI_FLAG_DESC[$f]}")"$'\n.RE\n'
        done
    done
    options=""
    for spec in "${CLI_GLOBAL_FLAGS[@]}"; do
        options+=$'.TP\n'".B $(_man_escape "${spec//|/, }")"$'\n'"$(_man_text "${CLI_GLOBAL_DESC[$spec]}")"$'\n'
    done
    while IFS= read -r line; do
        case $line in
            @COMMANDS@) printf '%s' "$commands" ;;
            @OPTIONS@)  printf '%s' "$options" ;;
            *)          printf '%s\n' "${line//@DATE@/$date}" ;;
        esac
    done < "$template"
}

# ------------------------------------------------------------------- main --

# Colour has to be decided before anything below can fail, so every usage
# error raised while parsing arguments (an unknown flag, a bad --color
# value, an unsupported flag combination) reflects the same decision as the
# command that would otherwise have run. Scan the flags a real invocation
# would see (up to the first --): the last valid --color=WHEN wins, but
# --json or --quiet always force "never" regardless of where they appear,
# same as the authoritative check further down.
_toolbox_color_arg=""
_toolbox_forced_never=0
for _toolbox_arg in "$@"; do
    case $_toolbox_arg in
        --) break ;;
        --color=auto|--color=always|--color=never)
            _toolbox_color_arg=${_toolbox_arg#--color=} ;;
        --json|--quiet) _toolbox_forced_never=1 ;;
    esac
done
[[ -z $_toolbox_color_arg ]] || TOOLBOX_COLOR=$_toolbox_color_arg
[[ $_toolbox_forced_never -eq 0 ]] || TOOLBOX_COLOR=never
unset _toolbox_color_arg _toolbox_forced_never _toolbox_arg
export TOOLBOX_COLOR
toolbox_color_setup

ARGS=()
LXC_FLAGS=()
# Command-specific flags, in the order given. They are accepted anywhere on
# the line and checked against CLI_FLAGS once the command is known.
SEEN_FLAGS=()
WANT_HELP=0
while [[ $# -gt 0 ]]; do
    case $1 in
        -y|--yes)   ASSUME_YES=1 ;;
        -f|--force) FORCE=1 ;;
        --json)     OUTPUT_JSON=1; SEEN_FLAGS+=("$1") ;;
        --quiet)    OUTPUT_QUIET=1; SEEN_FLAGS+=("$1") ;;
        --color=*)  case ${1#--color=} in
                        auto|always|never) ;;
                        *) usage_error "--color must be auto, always or never" ;;
                    esac ;;
        --color)    usage_error "--color needs a value: --color=auto|always|never" ;;
        --dry-run|--allow-removals|--notify) LXC_FLAGS+=("$1"); SEEN_FLAGS+=("$1") ;;
        -V|--version) printf 'pve-toolbox %s\n' "$TOOLBOX_VERSION"; exit 0 ;;
        -h|--help)  WANT_HELP=1 ;;
        --)         shift; ARGS+=("$@"); break ;;
        -*)         mapfile -t _toolbox_s < <(cli_long_flags)
                    mapfile -t _toolbox_s < <(cli_suggest "${1%%=*}" "${_toolbox_s[@]}")
                    cli_usage_error "unknown flag: $1" "" "${_toolbox_s[@]}" ;;
        *)          ARGS+=("$1") ;;
    esac
    shift
done

command_name=${ARGS[0]:-menu}
# Help first: '<command> --help' answers even when other flags on the line
# would not be accepted by the command itself.
if [[ $WANT_HELP -eq 1 ]]; then
    if [[ ${#ARGS[@]} -eq 0 ]]; then
        cli_help_overview
        exit 0
    fi
    cli_help_topic "$command_name"
    exit 0
fi
cli_in "$command_name" "${CLI_COMMANDS[@]}" "${CLI_HIDDEN[@]}" \
    || cli_unknown_command "$command_name"
# A help topic only for commands documented in help; a hidden command (used
# by the completion scripts) has none, so its usage errors point at the
# general help instead of a "pve-toolbox help _complete" that would not
# resolve to anything.
command_topic=$command_name
cli_in "$command_name" "${CLI_COMMANDS[@]}" || command_topic=""
for _toolbox_flag in "${SEEN_FLAGS[@]}"; do
    # shellcheck disable=SC2086 # CLI_FLAGS values are space-separated lists.
    cli_in "$_toolbox_flag" ${CLI_FLAGS[$command_name]:-} \
        || cli_usage_error "$_toolbox_flag is not supported by '$command_name'" "$command_topic"
done
unset _toolbox_flag
[[ $OUTPUT_JSON -eq 0 || $OUTPUT_QUIET -eq 0 ]] \
    || cli_usage_error "--json and --quiet cannot be used together" "$command_topic"
export ASSUME_YES FORCE TOOLBOX_ROOT TOOLBOX_PACKAGED

case $command_name in
    menu)        menu ;;
    lxc-update)  exec bash "$MODULE_DIR/lxc-update/run.sh" "${LXC_FLAGS[@]}" "${ARGS[@]:1}" ;;
    list)        cmd_list "${ARGS[@]:1}" ;;
    install)     [[ ${#ARGS[@]} -lt 2 ]] && cli_usage_error "install needs a module name" install
                 cmd_each module_install "${ARGS[@]:1}" ;;
    update)      cmd_each module_update "${ARGS[@]:1}" ;;
    check)       if [[ $OUTPUT_JSON -eq 1 || $OUTPUT_QUIET -eq 1 ]]; then
                     cmd_module_report check module_update --check "${ARGS[@]:1}"
                 else
                     cmd_each module_update --check "${ARGS[@]:1}"
                 fi ;;
    status)      if [[ $OUTPUT_JSON -eq 1 || $OUTPUT_QUIET -eq 1 ]]; then
                     cmd_module_report status module_status_long "${ARGS[@]:1}"
                 else
                     cmd_each module_status_long "${ARGS[@]:1}"
                 fi ;;
    doctor)      [[ ${#ARGS[@]} -eq 1 ]] || cli_usage_error "doctor takes no arguments" doctor
                 cmd_doctor ;;
    config)      cmd_config "${ARGS[@]:1}" ;;
    uninstall)   [[ ${#ARGS[@]} -lt 2 ]] && cli_usage_error "uninstall needs a module name" uninstall
                 cmd_each module_uninstall "${ARGS[@]:1}" ;;
    ui)          cmd_ui ;;
    link)        cmd_link ;;
    _complete)   cmd_complete "${ARGS[@]:1}" ;;
    _man)        cmd_man ;;
    self-update) cmd_self_update ;;
    help)        if [[ ${#ARGS[@]} -eq 1 ]]; then
                     cli_help_overview
                 else
                     cli_help_topic "${ARGS[1]}"
                 fi ;;
    *)           cli_unknown_command "$command_name" ;;
esac
